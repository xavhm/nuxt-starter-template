{
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commit": true,
    "commitMessage": "build: release with tag v${version}",
    "tag": true,
    "tagName": "v${version}",
    "push": true
  },

  "npm": {
    "publish": false
  },

  "github": {
    "release": false
  },

  "hooks": {
    "after:@release-it/conventional-changelog:beforeRelease": "pnpm exec vp fmt CHANGELOG.md"
  },

  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features",
            "effect": "bump"
          },
          {
            "type": "fix",
            "section": "Bug Fixes",
            "effect": "bump"
          },
          {
            "type": "chore",
            "section": "Maintenance",
            "effect": "bump"
          }
        ]
      }
    }
  }
}
